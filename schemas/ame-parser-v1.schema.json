{
  "$id": "https://example.invalid/ame-parser/v1.0/schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "pages_processed": {
      "minimum": 0,
      "type": "integer"
    },
    "parser_version": {
      "type": "string"
    },
    "records": {
      "items": {
        "properties": {
          "certificate_classes": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "condition": {
            "minLength": 1,
            "type": "string"
          },
          "disposition": {
            "enum": [
              "ISSUE",
              "DEFER",
              "DENY",
              "SPECIAL_ISSUANCE",
              "UNKNOWN"
            ]
          },
          "raw_disposition": {
            "type": "string"
          },
          "record_id": {
            "minLength": 1,
            "type": "string"
          },
          "scenario": {
            "minLength": 1,
            "type": "string"
          },
          "source": {
            "properties": {
              "document": {
                "minLength": 1,
                "type": "string"
              },
              "pdf_page": {
                "minimum": 1,
                "type": "integer"
              }
            },
            "required": [
              "document",
              "pdf_page"
            ],
            "type": "object"
          },
          "time_constraints": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "record_id",
          "condition",
          "scenario",
          "disposition",
          "raw_disposition",
          "requirements",
          "source",
          "raw_text"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "schema_version": {
      "const": "1.0"
    },
    "source_document": {
      "minLength": 1,
      "type": "string"
    },
    "summary": {
      "additionalProperties": {
        "minimum": 0,
        "type": "integer"
      },
      "type": "object"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "parser_version",
    "source_document",
    "pages_processed",
    "records",
    "warnings",
    "summary"
  ],
  "title": "AME Parser Result",
  "type": "object"
}
